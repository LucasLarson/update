#!/usr/bin/env sh
update='2026-10-11'
printf -- '\n\n                 .___       __\n __ ________   __\174 _\057____ _\057  \174_  ____\n\174  \174  \134____ \134 \057 __ \174\134__  \134\134   __\134\057 __ \134\n\174  \174  \057  \174_\076 \076 \057_\057 \174 \057 __ \134\174  \174 \134  ___\057\n\174____\057\174   __\057\134____ \174\050____  \057__\174  \134___  \076\n      \174__\174        \134\057     \134\057          \134\057\n a Lucas Larson production\n\n' >&2 && sleep 1
printf -- '\360\237\223\241  verifying network connectivity' >&2
sleep 1
i='0'
while test "${i-}" -lt "$(getconf -- CHAR_MAX)"; do
  if test "$((i / 3 % 2))" -eq '0'; then
    printf -- '.' >&2
  else
    printf -- '\b' >&2
  fi
  i="$((i + 1))"
done
unset i >/dev/null 2>&1 || i=''
printf -- '\n\n' >&2
ping -c 1 -- github.com >/dev/null 2>&1 || {
  update="${?-}"
  printf -- 'No internet connection detected.\nAborting update.\n' >&2
  case "${SHELL##*/}" in *"${0##*-}") return "${update:-1}" ;; *) exit "${update:-1}" ;; esac
}
set -- 'https://lucaslarson.net/update'
test "$({ wget --hsts-file=/dev/null --output-document=- --quiet -- "${1-}" || curl --location --silent --url "${1-}"; } 2>/dev/null | sed -n -e '/update=/ {' -e 's/[^[:digit:]]//gp' -e 'q' -e '}')" -le "$(printf -- '%s\n' "${update-}" | sed -e 's/[^[:digit:]]//g')" || {
  printf -- 'An update to this updater is available\041 Download it here:\n%s\n' "${1-}" >&2
  unset update >/dev/null 2>&1 || update=''
  case "${SHELL##*/}" in *"${0##*-}") return "${update:-1}" ;; *) exit "${update:-1}" ;; esac
}
printf -- '\360\237\215\272  checking for Homebrew installation...' >&2
if command -v -- brew >/dev/null 2>&1; then
  printf -- '  \342\234\205  found\n' >&2
  printf -- '\360\237\215\272  checking for Homebrew updates...\n' >&2
  brew update
  defaults export com.apple.dock "${TMPDIR:-${TMPPREFIX:-/tmp}}"'/.com.apple.dock.plist' >/dev/null 2>&1 && {
    brew upgrade --cask --greedy --verbose
    defaults import com.apple.dock "${TMPDIR:-${TMPPREFIX:-/tmp}}"'/.com.apple.dock.plist' 2>/dev/null && killall -z -- Dock 2>/dev/null
  }
  brew upgrade --greedy --verbose
else
  printf -- 'No Homebrew installation detected.\n\n' >&2
fi
printf -- '\360\237\217\224  checking for Alpine Package Keeper installation...\n' >&2
if command -v -- apk >/dev/null 2>&1; then
  printf -- '\360\237\217\224  apk update...\n' >&2
  apk update --progress --verbose --verbose
  printf -- '\n\360\237\217\224  apk upgrade...\n' >&2
  apk upgrade --progress --update-cache --verbose --verbose
  printf -- '\n\360\237\217\224  apk fix...\n' >&2
  apk fix --progress --verbose --verbose
  printf -- '\n\360\237\217\224  apk verify...\n' >&2
  apk verify --progress --verbose --verbose
  printf -- '\360\237\217\224  apk verify complete...\n\n' >&2
else
  printf -- 'no Alpine Package Keeper installation detected.\n\n' >&2
fi
printf -- 'checking access to Software Update...\n' >&2
if command -v -- softwareupdate >/dev/null 2>&1; then
  printf -- '\360\237\215\216  ' >&2
  softwareupdate --all --list --verbose
else
  printf -- 'no Software Update installation detected.\n\n' >&2
fi
printf -- 'checking for Xcode installation...\n' >&2
if command -v -- xcrun >/dev/null 2>&1; then
  printf -- 'removing unavailable device simulators...\n' >&2
  xcrun simctl delete unavailable
else
  printf -- 'no Xcode installation detected.\n\n' >&2
fi
printf -- '\342\232\233\357\270\217  checking for Atom installation...\n' >&2
if command -v -- apm >/dev/null 2>&1; then
  apm upgrade --no-confirm
else
  printf -- 'no Atom installation detected.\n\n' >&2
fi
printf -- '\360\237\214\240  checking for Cabal installation...\n' >&2
if command -v -- cabal >/dev/null 2>&1; then
  cabal update --verbose
else
  printf -- 'no Cabal installation detected.\n\n' >&2
fi
printf -- '\360\237\246\200  checking for Rust installation...\n' >&2
if command -v -- rustup >/dev/null 2>&1; then
  rustup --verbose update
else
  printf -- 'no Rust installation detected.\n\n' >&2
fi
printf -- 'checking for npm installation...\n' >&2
if command -v -- npm >/dev/null 2>&1; then
  printf -- '...and whether this device is can update npm quickly...\n' >&2
  if test "$(getconf -- LONG_BIT)" -gt 32; then
    while test "$(find -- "$(npm config --location=global get prefix)" -name '.DS_Store' -type f -print)" != ''; do find -- "$(npm config --location=global get prefix)" -name '.DS_Store' -type f -delete; done
    npm install --location=global --loglevel=verbose --no-fund -- npm
    while test "$(find -- "$(npm config --location=global get prefix)" -name '.DS_Store' -type f -print)" != ''; do find -- "$(npm config --location=global get prefix)" -name '.DS_Store' -type f -delete; done
    npm update --location=global --loglevel=verbose --no-fund && npm ls --json --location=global --loglevel=verbose >"${DOTFILES:-${HOME%/}}"'/.package-list.json'
  else
    printf -- 'skipping npm update...\n\n' >&2
    sleep 1
    printf -- 'to update npm later, run:\n\n' >&2
    printf -- '    npm i -g npm \046\046 \134\n' >&2
    printf -- '    npm update -g\n\n\n' >&2
    sleep 3
  fi
else
  printf -- 'no npm installation detected.\n\n' >&2
fi
printf -- 'checking for RubyGems installation...\n' >&2
if command -v -- gem >/dev/null 2>&1; then
  printf -- 'updating RubyGems...\n' >&2
  gem update --system --verbose
  gem update --verbose
  if bundle update >/dev/null 2>&1; then
    bundle update --verbose
  fi
  if bundle install >/dev/null 2>&1; then
    bundle install --verbose
  fi
  printf -- 'checking for CocoaPods installation...\n' >&2
  if bundle exec pod install >/dev/null 2>&1; then
    bundle exec pod install --verbose
  fi
  if pod repo update >/dev/null 2>&1; then
    pod repo update --verbose
  fi
else
  printf -- 'no RubyGems installation detected.\n\n' >&2
fi
if command -v -- rbenv >/dev/null 2>&1; then
  rbenv rehash
fi
if command -v -- c_rehash >/dev/null 2>&1; then
  c_rehash
fi
if command -v -- python3 >/dev/null 2>&1; then
  printf -- '\n\360\237\220\215  verifying Python\342\200\231s packager is up to date...\n' >&2
  python3 -m pip install --upgrade --verbose --verbose -- pip
  printf -- 'verifying pip installation...\n' >&2
  if python3 -m pip >/dev/null 2>&1; then
    printf -- '\n\360\237\220\215  updating outdated Python packages...\n' >&2
    python3 -m pip list --format=columns --outdated | sed -n -e '3,$ s/^\([^[:space:]]*\).*/\1/p' | while IFS='' read -r -- package; do python3 -m pip install --upgrade --verbose --verbose -- "${package-}"; done
  fi
  printf -- 'checking for pyenv installation...\n' >&2
  if command -v -- pyenv >/dev/null 2>&1; then
    printf -- 'rehashing pyenv shims...\n' >&2
    pyenv rehash
  else
    printf -- 'no pyenv installation detected.\n\n' >&2
  fi
  printf -- 'checking for Conda installation...\n' >&2
  if command -v -- conda >/dev/null 2>&1; then
    conda update --all --yes
  else
    printf -- 'no Conda installation detected.\n\n' >&2
  fi
fi
if command -v -- brew >/dev/null 2>&1; then
  brew generate-man-completions --debug --verbose
  brew bundle dump --cask --debug --file=- --force --formula --mas --no-restart --tap | sed -e '$! N' -e '/^#.*\n[^#]/ s/\n/\t/' -e 'P' -e 'D' | sed -e 's/\(.*\)\t\(.*\)/\2\1/' | sed -e 's/^\(tap\)/1\1/' -e 's/^\(brew\)/2\1/' -e 's/^\(cask\)/3\1/' | LC_ALL='C' sort -f | {
    printf -- '#!/usr/bin/env ruby\n'
    printf -- '# frozen_string_literal: true\n\n'
    sed -e 's/^[[:digit:]]//' -e 's/\([^#]*\)\(#.*\)/\2\n\1/'
  } >"${HOMEBREW_BUNDLE_FILE_GLOBAL:-${HOMEBREW_BUNDLE_FILE:-${HOME%/}/.Brewfile}}" && chmod -- 755 "${HOMEBREW_BUNDLE_FILE_GLOBAL:-${HOMEBREW_BUNDLE_FILE:-${HOME%/}/.Brewfile}}"
fi
if command -v -- omz >/dev/null 2>&1; then
  omz update 2>/dev/null
fi
if command -v -- rehash >/dev/null 2>&1; then
  rehash
fi
unset update >/dev/null 2>&1 || update=''
printf -- '\n\342\234\205  update complete\n' >&2
case "${SHELL##*/}" in *"${0##*-}") return ;; *) exit ;; esac
